SECRET_KEY=change-me
DEBUG=True
# Comma-separated hostnames Django will serve. Required once DEBUG=False —
# previously hardcoded to [] in config/settings.py, which rejected every
# request in production; now env-driven. Leave unset for local dev/tests
# (Django's test client adds 'testserver' automatically regardless).
ALLOWED_HOSTS=

# Bootstrap accounts created by `python manage.py seed` (main/management/commands/seed.py).
# Leave either pair blank to skip creating that account. Never commit real
# credentials here — this file only documents the variable names.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

DB_ENGINE=django.db.backends.postgresql
DB_NAME=corpus_db
DB_USER=corpus_user
DB_PASSWORD=changethistoyourownpassword
DB_HOST=localhost
DB_PORT=5432

# Celery broker/result backend. Used by worker/celery_app.py. The worker is
# the ONLY writer of Token/WordType/DocumentWordFreq/DocumentNgram/
# ErrorAnnotation/DocumentErrorFreq — an upload with no worker running
# leaves the document untokenized and invisible to every analysis feature
# (docs/ONBOARDING.md §6, info/new_device.md §5). Not optional.
REDIS_URL=redis://localhost:6379/0

# JWT signing key shared between Django (issues tokens) and FastAPI
# (verifies them statelessly) — architecture plan §3. Deliberately separate
# from SECRET_KEY. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me

# Comma-separated origins allowed to call /api/* cross-origin (architecture
# plan §6, Phase 3) — KUIS-FE's own origin, not this backend's. Defaults to
# the local Next.js dev server if unset.
CORS_ALLOWED_ORIGINS=http://localhost:3000
