SECRET_KEY=change-me
DEBUG=True
# Comma-separated hostnames Django will serve. Required once DEBUG=False —
# previously hardcoded to [] in config/settings.py, which rejected every
# request in production; now env-driven. Leave unset for local dev/tests
# (Django's test client adds 'testserver' automatically regardless).
ALLOWED_HOSTS=

DB_ENGINE=django.db.backends.postgresql
DB_NAME=corpus_db
DB_USER=corpus_user
DB_PASSWORD=changethistoyourownpassword
DB_HOST=localhost
DB_PORT=5432

# Celery broker/result backend. Used by worker/celery_app.py — no tasks are
# registered yet (Phase 0 scaffold only), but the service needs this to boot.
REDIS_URL=redis://localhost:6379/0
